    "No connection. Pull to refresh.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion. Tire pour actualiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Zum Aktualisieren ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Desliza para actualizar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ligação. Puxa para atualizar."
          }
        },
        "it": {
          "stringUnit": {
