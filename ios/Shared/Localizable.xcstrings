    "Did you ride? Tell windext how it was, it helps the next rider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warst du auf dem Wasser? Sag windext, wie es war, das hilft dem nächsten Rider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Saliste? Cuéntale a windext cómo fue, ayuda al siguiente rider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as navigué ? Dis à windext comment c'était, ça aide le rider suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei uscito? Racconta a windext com'è andata, aiuta il prossimo rider."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben je gaan varen? Vertel windext hoe het was, dat helpt de volgende rider."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foste para a água? Diz ao windext como foi, ajuda o próximo rider."
          }
        }
      }
    },
