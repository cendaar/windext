          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding. Trek om te vernieuwen."
          }
        }
      }
    },
    "Updated %@. Seven weather models, read for your gear.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis à jour à %@. Sept modèles météo, lus pour ton matériel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert um %@. Sieben Wettermodelle, gelesen für dein Material."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizado a las %@. Siete modelos meteorológicos, leídos para tu material."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizado às %@. Sete modelos meteorológicos, lidos para o teu material."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornato alle %@. Sette modelli meteo, letti per la tua attrezzatura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijgewerkt om %@. Zeven weermodellen, gelezen voor jouw materiaal."
          }
        }
      }
    },
