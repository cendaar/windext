    "Is it worth going today and tomorrow, at a glance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lohnt es sich heute und morgen, auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Merece la pena hoy y mañana? De un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça vaut le coup aujourd'hui et demain, en un coup d'œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena oggi e domani, a colpo d'occhio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is het vandaag en morgen de moeite waard, in één oogopslag."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a pena hoje e amanhã, num relance."
          }
        }
      }
    },
    "Is it worth going? One answer for today, one for tomorrow, for your spot and your gear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lohnt es sich? Eine Antwort für heute, eine für morgen, für deinen Spot und dein Material."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Merece la pena ir? Una respuesta para hoy y otra para mañana, para tu spot y tu material."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça vaut le coup d'y aller ? Une réponse pour aujourd'hui, une pour demain, pour ton spot et ton matériel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena andare? Una risposta per oggi, una per domani, per il tuo spot e la tua attrezzatura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is het de moeite waard? Eén antwoord voor vandaag, één voor morgen, voor jouw spot en jouw materiaal."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a pena ir? Uma resposta para hoje, outra para amanhã, para o teu spot e o teu material."
          }
        }
      }
    },
