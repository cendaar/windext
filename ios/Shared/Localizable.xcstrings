    "Is it worth going today and tomorrow, at a glance.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça vaut le coup aujourd'hui et demain, en un coup d'œil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lohnt es sich heute und morgen, auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Merece la pena hoy y mañana? De un vistazo."
          }
        },
