    },
    "windext reads seven weather models and tells you, in plain words, whether it is worth going and when." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "windext liest sieben Wettermodelle und sagt dir klar, ob es sich lohnt und wann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "windext lee siete modelos meteorológicos y te dice, claramente, si merece la pena ir y cuándo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "windext lit sept modèles météo et te dit, en clair, si ça vaut le coup d'y aller et quand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "windext legge sette modelli meteo e ti dice, in modo chiaro, se vale la pena andare e quando."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "windext leest zeven weermodellen en zegt je in gewone woorden of het de moeite waard is en wanneer."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O windext lê sete modelos meteorológicos e diz-te, de forma clara, se vale a pena ir e quando."
          }
        }
      }
    },
